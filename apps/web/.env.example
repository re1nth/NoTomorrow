# Cloud-mode env for the hosted web service. Copy to `.env.local` for
# local dev, or set as container / platform secrets in production. Not
# needed when running the Electron desktop app — the launcher sets
# everything it needs at runtime.

# Auth strategy: `cloud` boots the Auth.js codepath (email + password
# via the Credentials provider). `local` (or unset) uses the single-user
# desktop strategy.
NOTOMORROW_AUTH=cloud

# Absolute path to the SQLite file. In dev, anywhere writable; in
# production, the volume mount point (e.g. Fly volume, docker volume).
SQLITE_DB_PATH=/tmp/notomorrow.db

# Auth.js JWT signing secret. Generate with:
#   openssl rand -hex 32
AUTH_SECRET=

# Set behind a proxy or load balancer (Fly, Vercel, etc.). Required in
# production for Auth.js to trust the forwarded Host header.
AUTH_TRUST_HOST=true

# OAuth providers — each is optional and shown on /login only when its
# ID + SECRET are both set to non-placeholder values. Each provider
# needs a matching redirect URI registered on its developer console:
#   http://localhost:3000/api/auth/callback/<provider>   (dev)
#   https://<your-host>/api/auth/callback/<provider>     (prod)
# where <provider> is one of: google, github, microsoft-entra-id,
# facebook. See https://authjs.dev/getting-started/providers for setup
# guides per provider.

# Google — Google Cloud Console → APIs & Services → Credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub — github.com/settings/developers → New OAuth App
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Microsoft Entra ID — portal.azure.com → App registrations → New
# registration. Default tenant `common` accepts both personal accounts
# (outlook/hotmail/live) and any work/school tenant.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=common

# Facebook — developers.facebook.com → My Apps → Add Product → Facebook
# Login. Requires App Review before production users outside the test
# list can sign in.
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
