# Cloud-mode env for the hosted web service. Copy to `.env.local` for
# local dev, or set as Fly secrets in production. Not needed when
# running the Electron desktop app — the launcher sets everything it
# needs at runtime.

# Auth strategy: `cloud` boots the Auth.js codepath (Google OAuth).
# `local` (or unset) uses the single-user desktop strategy.
NOTOMORROW_AUTH=cloud

# Absolute path to the SQLite file. In dev, anywhere writable; in
# production, the Fly volume mount point.
SQLITE_DB_PATH=/tmp/notomorrow.db

# Auth.js session-cookie signing secret. Generate with:
#   openssl rand -hex 32
AUTH_SECRET=

# Google OAuth client. Create in Google Cloud Console → APIs &
# Services → Credentials → OAuth 2.0 Client ID (Web application).
# Authorised redirect URI:
#   http://localhost:3000/api/auth/callback/google   (dev)
#   https://<your-domain>/api/auth/callback/google   (prod)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Set behind a proxy or load balancer (Fly, Vercel, etc.). Required in
# production for Auth.js to trust the forwarded Host header.
AUTH_TRUST_HOST=true
