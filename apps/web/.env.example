# Cloud-mode env for the hosted web service. Copy to `.env.local` for
# local dev, or set as container / platform secrets in production. Not
# needed when running the Electron desktop app — the launcher sets
# everything it needs at runtime.

# Auth strategy: `cloud` boots the Auth.js codepath (email + password
# via the Credentials provider). `local` (or unset) uses the single-user
# desktop strategy.
NOTOMORROW_AUTH=cloud

# Absolute path to the SQLite file. In dev, anywhere writable; in
# production, the volume mount point (e.g. Fly volume, docker volume).
SQLITE_DB_PATH=/tmp/notomorrow.db

# Auth.js JWT signing secret. Generate with:
#   openssl rand -hex 32
AUTH_SECRET=

# Set behind a proxy or load balancer (Fly, Vercel, etc.). Required in
# production for Auth.js to trust the forwarded Host header.
AUTH_TRUST_HOST=true

# Google OAuth (optional). When both are set to non-placeholder values,
# the login and register pages show a "Continue with Google" button. In
# Google Cloud Console, add the redirect URI:
#   http://localhost:3000/api/auth/callback/google    (dev)
#   https://<your-host>/api/auth/callback/google      (prod)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
